# Zkopíruj jako .env a doplň. NIKDY necommituj .env do gitu.
SUPABASE_URL=https://rkyewweuirnnzrfpazbf.supabase.co
# --- A) Tvůj vlastní sběrač: Supabase -> Project Settings -> API Keys -> Secret key (sb_secret_...)
SUPABASE_SECRET_KEY=sb_secret_...
# --- B) Sběrač u někoho jiného: secret klíč NEVYPLŇOVAT, stačí token od vlastníka (veřejný klíč je předvyplněný).
# Se secret klíčem by měl plný přístup k databázi; s tokenem umí jen přidávat dary k povoleným účtům.
# COLLECTOR_TOKEN=gbc_...
SUPABASE_PUBLISHABLE_KEY=sb_publishable_sqHEZ6m0Wi-9Ae5vbhlZQQ_aGTFKzvP
# Účty k hlídání (oddělené čárkou) – nebo je předej jako argumenty
STREAMERS=a_d_e_ll_o_ff_i_c_i_a_l_
CHECK_INTERVAL=60
# Volitelné: klíč pro podepisovací server TikTokLive (eulerstream.com) při omezení požadavků
EULER_API_KEY=
# Volitelné: log i do souboru vedle skriptu (nutné pro běh na pozadí přes Plánovač úloh)
LOG_FILE=collector.log
# Volitelné: jméno sběrače zobrazené na webu (výchozí = název počítače; s tokenem ho určuje vlastník)
# COLLECTOR_NAME=PC
# Volitelné: nahrávat video vysílání (potřeba ffmpeg – Windows: winget install ffmpeg)
# Záznamy: recordings\<účet>\RRRR-MM-DD_HH-MM.mp4 (hodina ≈ 0,5–2 GB podle kvality)
RECORD=0
RECORD_DIR=recordings
# origin = nejlepší dostupná; uhd 720p, hd 540p, sd/ld 480p
RECORD_QUALITY=origin
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# Volitelné: hotová MP4 přesunout do sdílené složky (nahrává se lokálně, přesune se až po konci vysílání)
# RECORD_SHARE_DIR=C:\Users\Admin\OneDrive\TikTok
# Volitelné: po vysílání vyrobit i *_overlay.mp4 s dary, komentáři a pruhem bitvy (překódování – na slabším PC
# trvá i déle než samotné vysílání, běží se sníženou prioritou). Ručně kdykoli: přetáhni MP4 na overlay.bat
RECORD_OVERLAY=0
# Posun vrstvy v sekundách, když dary předbíhají (+) nebo zaostávají (-) za obrazem
# OVERLAY_DELAY=0
